{
  "manifest_version": 3,
  "name": "FreeModel Lab Bridge",
  "version": "0.2.0",
  "description": "User-triggered secure key handoff to the local FreeModel Lab app.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "externally_connectable": {
    "matches": ["http://127.0.0.1/*"]
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FreeModel Lab Bridge"
  }
}
