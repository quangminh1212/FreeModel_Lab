{
  "name": "freemodel-lab",
  "version": "0.2.0",
  "description": "Local free provider catalog, secure API key vault, and endpoint integration",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quangminh1212/FreeModel_Lab.git"
  },
  "homepage": "https://github.com/quangminh1212/FreeModel_Lab#readme",
  "bugs": {
    "url": "https://github.com/quangminh1212/FreeModel_Lab/issues"
  },
  "keywords": [
    "llm",
    "api",
    "provider-catalog",
    "credential-manager",
    "local-dashboard"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "freemodel-lab": "dist/cli.js"
  },
  "files": [
    "dist/",
    "web/",
    "extension/",
    "scripts/dev.cjs",
    "scripts/dev-reload.js",
    "scripts/check-web-assets.js",
    "scripts/run-headless.cjs",
    "run.bat",
    "run-hidden.vbs",
    "open-dashboard.vbs",
    "README.md",
    "AI_GUIDE.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node scripts/dev.cjs",
    "prepare": "npm run build",
    "start": "node dist/cli.js start",
    "check:web": "node scripts/check-web-assets.js"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2",
    "chokidar": "^4.0.3",
    "open": "^11.0.4",
    "postject": "1.0.0-alpha.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^7.0.2"
  }
}
